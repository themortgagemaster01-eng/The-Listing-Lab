# Supabase project URL (Project Settings -> API -> Project URL). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public API key (Project Settings -> API -> anon public). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (Project Settings -> API -> service_role secret). SERVER ONLY — never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API key, used by src/lib/ai for AI-generated flyer/marketing copy. SERVER ONLY — never expose to the browser or commit.
OPENAI_API_KEY=
