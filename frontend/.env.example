# --- Server-side (add these in Vercel exactly as named, no NEXT_PUBLIC_ prefix needed) ---

# Supabase project URL (Project Settings -> API). Same value used for both server and browser access.
SUPABASE_URL=

# Supabase secret key (Project Settings -> API -> Secret keys, sb_secret_... form). SERVER ONLY — never expose to the browser or commit.
SUPABASE_SECRET_KEY=

# Supabase JWKS URL (Project Settings -> API -> JWT Keys), used for verifying auth tokens once real user auth is wired. SERVER ONLY.
SUPABASE_JWKS_URL=

# OpenAI API key, used by src/lib/ai for AI-generated flyer/marketing copy. SERVER ONLY — never expose to the browser or commit.
OPENAI_API_KEY=

# --- Browser-side duplicates (required — Next.js only inlines NEXT_PUBLIC_-prefixed vars into client bundles) ---
# Add these two with the SAME values as SUPABASE_URL / SUPABASE_SECRET_KEY... except this one must be the
# PUBLISHABLE key (sb_publishable_... form), never the secret key. Safe to expose to the browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy naming also supported by the code as a fallback, in case an older Supabase project uses it instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY= (browser)
# SUPABASE_SERVICE_ROLE_KEY=     (server)
